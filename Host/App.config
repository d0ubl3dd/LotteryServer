<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
		<section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
	</configSections>

	<appSettings>
		<add key="log4net.Internal.Debug" value="false"/>
	</appSettings>

	<log4net>
		<appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
			<file value="Logs/WCFService.log" />
			<appendToFile value="true" />
			<rollingStyle value="Date" />
			<datePattern value="'-'yyyy-MM-dd'.log'" />
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date %-5level %logger - %message%newline%exception" />
			</layout>
		</appender>

		<logger name="WCFServiceLogger">
			<level value="INFO" />
			<appender-ref ref="RollingFileAppender" />
		</logger>

		<root>
			<level value="ERROR"/>
			<appender-ref ref="RollingFileAppender"/>
		</root>
	</log4net>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>

	<connectionStrings>
		<add name="lottery_databaseEntities" connectionString="metadata=res://*/LotteryDataModel.csdl|res://*/LotteryDataModel.ssdl|res://*/LotteryDataModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=localhost\SQLEXPRESS;initial catalog=lottery_database;user id=lottery_user;password=L0tt3ry$2025;encrypt=True;trustservercertificate=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
	</connectionStrings>

	<entityFramework>
		<providers>
			<provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
		</providers>
	</entityFramework>

	<system.serviceModel>
		<bindings>
			<netTcpBinding>
				<binding name="LotteryTcpBinding"
						 maxBufferSize="2147483647"
						 maxReceivedMessageSize="2147483647"
						 receiveTimeout="00:10:00"
						 sendTimeout="00:02:00"
						 openTimeout="00:00:10"
						 closeTimeout="00:00:10">

					<readerQuotas maxDepth="32"
								  maxStringContentLength="2147483647"
								  maxArrayLength="2147483647"
								  maxBytesPerRead="2147483647"
								  maxNameTableCharCount="2147483647" />

					<security mode="None" />

					<reliableSession enabled="true" inactivityTimeout="00:02:00" ordered="true"/>
				</binding>
			</netTcpBinding>
		</bindings>

		<extensions>
			<behaviorExtensions>
				<add name="globalErrorBehavior" type="BusinessLogic.GlobalErrorBehaviorExtension, BusinessLogic" />
			</behaviorExtensions>
		</extensions>

		<behaviors>
			<serviceBehaviors>
				<behavior name="LotteryServiceBehavior">
					<serviceMetadata httpGetEnabled="true" />
					<serviceDebug includeExceptionDetailInFaults="true" />
					<globalErrorBehavior />
				</behavior>
			</serviceBehaviors>
		</behaviors>

		<services>
			<service name="BusinessLogic.LotteryService" behaviorConfiguration="LotteryServiceBehavior">
				<host>
					<baseAddresses>
						<!-- Localhost para pruebas locales -->
					<add baseAddress="http://localhost:8733/Lottery/" />
					<add baseAddress="net.tcp://localhost:8080/Lottery/" />

					<!-- Para conexion con otra pc 
						<add baseAddress="http://192.168.100.166:8733/Lottery/" />
						<add baseAddress="net.tcp://192.168.100.166:8080/Lottery/" /> -->
					</baseAddresses>
				</host>

				<endpoint address="LotteryService"
						  binding="netTcpBinding"
						  bindingConfiguration="LotteryTcpBinding"
						  contract="Contracts.ILotteryService" />
			</service>
		</services>
	</system.serviceModel>
</configuration>